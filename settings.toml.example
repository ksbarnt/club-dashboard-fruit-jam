# Club Dashboard configuration.
#
# CircuitPython reads this file automatically at boot -- no code changes
# needed to reconfigure the dashboard, just edit this file and reset the
# board (or save it again from the CIRCUITPY drive, which triggers a
# reload). Copy this file to settings.toml and replace every placeholder
# value below before use -- settings.toml itself is gitignored since it
# holds your WiFi password and API key.

# --- WiFi ---
# The Fruit Jam's ESP32-C6 co-processor joins this network at boot.
CIRCUITPY_WIFI_SSID = "your-wifi-ssid"
CIRCUITPY_WIFI_PASSWORD = "your-wifi-password"

# --- Club Dashboard Web ---
# Base URL (no trailing slash) of your club-dashboard-web deployment, and
# the raw static API key configured there (the same key whose SHA-256
# hash is stored as API_KEY_SHA256 in that project's .env -- pass the
# raw value here, not the hash).
DASHBOARD_URL = "http://192.168.1.50:5000"
DASHBOARD_API_KEY = "your-dashboard-api-key"

# --- Local display label ---
# Cosmetic only: the World Skills view's regional-rank column header
# (e.g. "Michigan Rk"). Does NOT filter or influence which data is
# fetched -- that's controlled entirely by club-dashboard-web's own
# Settings page. Keep this in sync by hand with whatever region
# club-dashboard-web is actually configured for.
EVENT_REGION = "Texas - Region 1"

# --- Local time ---
# CircuitPython has no timezone database, so the dashboard's "today" (for
# the Active Today view) is computed from a fixed hour offset from UTC.
# Examples: US Eastern standard -5, US Central standard -6, US Mountain
# standard -7, US Pacific standard -8 (add 1 during daylight saving).
TZ_OFFSET_HOURS = -6

# --- Behavior tuning (all optional -- shown values are the defaults) ---

# How often the Active Today view refreshes itself, in seconds. World
# Skills and Awards are refetched at most once per local calendar day
# instead (and cached to the SD card, if one is present) since that data
# rarely changes -- switching to either view checks for a new day.
REFRESH_INTERVAL_SECONDS = 300

# Auto-scroll speed for tables taller than the screen: SCROLL_STEP_LINES
# worth of table rows moved every SCROLL_DELAY_SECONDS, pausing
# SCROLL_PAUSE_SECONDS at the top and bottom of each pass. The defaults
# below scroll one line every 2 seconds, pausing 4 seconds at each end.
SCROLL_STEP_LINES = 1
SCROLL_DELAY_SECONDS = 2.0
SCROLL_PAUSE_SECONDS = 4.0

# Display resolution. Must be one of: 320x240, 360x200, 640x480, 720x400.
DISPLAY_WIDTH = 640
DISPLAY_HEIGHT = 480
